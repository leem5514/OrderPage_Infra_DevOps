{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOneStateBucketInSeoul",
      "Effect": "Allow",
      "Action": "s3:CreateBucket",
      "Resource": "arn:aws:s3:::orderpage-devops-tfstate-{{ACCOUNT_ID}}-ap-northeast-2",
      "Condition": { "StringEquals": { "s3:LocationConstraint": "ap-northeast-2" } }
    },
    {
      "Sid": "ReadStateBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketWebsite",
        "s3:GetBucketVersioning",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::orderpage-devops-tfstate-{{ACCOUNT_ID}}-ap-northeast-2",
      "Condition": { "StringEquals": { "s3:ResourceAccount": "{{ACCOUNT_ID}}" } }
    },
    {
      "Sid": "ManageStateBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::orderpage-devops-tfstate-{{ACCOUNT_ID}}-ap-northeast-2",
      "Condition": { "StringEquals": { "s3:ResourceAccount": "{{ACCOUNT_ID}}" } }
    },
    {
      "Sid": "DenyInsecureStateBucketRequests",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::orderpage-devops-tfstate-{{ACCOUNT_ID}}-ap-northeast-2",
        "arn:aws:s3:::orderpage-devops-tfstate-{{ACCOUNT_ID}}-ap-northeast-2/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
