# 복사해 terraform.tfvars로 사용한다. 실제 값은 Git에 올리지 않는다.
aws_region         = "ap-northeast-2"
kubernetes_version = "1.35"

# 문서용 IP/계정이다. 실제 운영자의 공인 IP와 IAM Role ARN으로 교체한다.
eks_public_access_cidrs = ["203.0.113.10/32"]
eks_admin_principal_arn = "arn:aws:iam::123456789012:role/OrderPageTerraformOperator"

# 의도적으로 유효하지 않은 예시: describe-addon-versions로 확인 후 채워야 plan이 통과한다.
eks_addon_versions = {
  vpc-cni    = "REPLACE_WITH_COMPATIBLE_VERSION"
  coredns    = "REPLACE_WITH_COMPATIBLE_VERSION"
  kube-proxy = "REPLACE_WITH_COMPATIBLE_VERSION"
}

# 서울 RDS API에서 확인한 10.11.x patch로 교체한다.
rds_engine_version = "REPLACE_WITH_SUPPORTED_10.11_PATCH"

# 실제 비밀번호는 예시에 넣지 않는다. 각각 다른 난수 영문/숫자 32~64자로 주입한다.
# TF_VAR_rds_master_password
# TF_VAR_redis_auth_token
# TF_VAR_rabbitmq_admin_password
# sensitive는 출력 마스킹이며 state 저장을 막지 않는다.
