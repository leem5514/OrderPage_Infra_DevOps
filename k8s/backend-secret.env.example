# 복사 위치: .local/secrets/backend.env. 실제 값은 Git에 올리지 않는다.
# DB/MQ에는 별도로 만든 앱 전용 계정을 사용한다.
DB_USERNAME=REPLACE_REQUIRED_APP_USER
DB_PASSWORD=REPLACE_REQUIRED_DB_PASSWORD
REDIS_PASSWORD=REPLACE_REQUIRED_REDIS_AUTH
RABBITMQ_USERNAME=REPLACE_REQUIRED_APP_USER
RABBITMQ_PASSWORD=REPLACE_REQUIRED_MQ_PASSWORD
JWT_SECRET_KEY=REPLACE_REQUIRED_ACCESS_SIGNING_KEY
JWT_SECRET_KEY_RT=REPLACE_REQUIRED_REFRESH_SIGNING_KEY
