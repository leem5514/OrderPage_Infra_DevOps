# 로컬 렌더용 미완성 값. prepare-deployment가 실제 endpoint/도메인/버킷으로 덮어쓴다.
DB_URL=REPLACE_REQUIRED_DB_URL
REDIS_HOST=REPLACE_REQUIRED_REDIS_HOST
REDIS_PORT=6379
REDIS_SSL_ENABLED=true
RABBITMQ_HOST=REPLACE_REQUIRED_RABBITMQ_HOST
RABBITMQ_PORT=5671
RABBITMQ_VHOST=/
RABBITMQ_SSL_ENABLED=true
AWS_REGION=ap-northeast-2
AWS_STS_REGIONAL_ENDPOINTS=regional
AWS_S3_BUCKET=REPLACE_REQUIRED_IMAGE_BUCKET
CORS_ALLOWED_ORIGINS=https://devops.auctionbid.shop
ADMIN_EMAIL=REPLACE_REQUIRED_ADMIN_EMAIL
BOOTSTRAP_ADMIN_ENABLED=false
ORDER_STOCK_PROCESSING_MODE=REDIS_ASYNC
