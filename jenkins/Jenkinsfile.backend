pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'BACKEND_REPOSITORY_URL', defaultValue: 'https://github.com/leem5514/OrderPage_BE_DevOps.git', description: '백엔드 GitHub repository URL')
        string(name: 'BACKEND_BRANCH', defaultValue: 'main', description: '빌드할 백엔드 브랜치')
        string(name: 'INFRA_REPOSITORY_URL', defaultValue: 'https://github.com/leem5514/OrderPage_Infra_DevOps.git', description: 'Kubernetes manifest가 있는 Infra repository URL')
        string(name: 'INFRA_BRANCH', defaultValue: 'main', description: '배포 manifest 브랜치')
        string(name: 'K8S_OVERLAY_PATH', defaultValue: 'k8s/overlays/dev', description: 'kubectl apply -k 대상 overlay 경로')
        string(name: 'EKS_NAMESPACE', defaultValue: 'orderpage', description: '배포 namespace')
        string(name: 'EKS_DEPLOYMENT_NAME', defaultValue: 'orderpage-backend', description: 'Kubernetes Deployment 이름')
        string(name: 'EKS_CONTAINER_NAME', defaultValue: 'orderpage-backend', description: '이미지를 교체할 컨테이너 이름')
        string(name: 'AWS_REGION', defaultValue: 'ap-northeast-2', description: 'AWS region')
        string(name: 'AWS_ACCOUNT_ID', defaultValue: '000000000000', description: 'AWS account ID. 실제 Jenkins에서는 값 또는 credential로 교체')
        string(name: 'ECR_REPOSITORY_NAME', defaultValue: 'orderpage-backend', description: 'Amazon ECR repository name')
        string(name: 'IMAGE_TAG', defaultValue: '', description: '비워두면 Jenkins BUILD_NUMBER 사용')
        choice(name: 'DEPLOY_TARGET', choices: ['build-only', 'ecr-push', 'eks-deploy'], description: '파이프라인 실행 범위')
    }

    environment {
        BACKEND_DIR = 'backend'
        INFRA_DIR = 'infra'
        IMAGE_NAME = 'orderpage-backend'
        AWS_DEFAULT_REGION = "${params.AWS_REGION}"
    }

    stages {
        stage('백엔드 소스 체크아웃') {
            steps {
                dir(env.BACKEND_DIR) {
                    git branch: params.BACKEND_BRANCH, url: params.BACKEND_REPOSITORY_URL
                }
            }
        }

        stage('이미지 태그 준비') {
            steps {
                script {
                    env.RESOLVED_IMAGE_TAG = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : env.BUILD_NUMBER
                    env.ECR_REGISTRY = "${params.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
                    env.ECR_IMAGE = "${env.ECR_REGISTRY}/${params.ECR_REPOSITORY_NAME}:${env.RESOLVED_IMAGE_TAG}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.RESOLVED_IMAGE_TAG}"
                }
            }
        }

        stage('백엔드 테스트') {
            steps {
                dir(env.BACKEND_DIR) {
                    sh 'chmod +x ./gradlew'
                    sh './gradlew test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${env.BACKEND_DIR}/build/test-results/test/*.xml"
                }
            }
        }

        stage('JAR 빌드') {
            steps {
                dir(env.BACKEND_DIR) {
                    sh './gradlew bootJar'
                }
            }
        }

        stage('Docker 이미지 빌드') {
            steps {
                dir(env.BACKEND_DIR) {
                    sh 'docker build -t ${IMAGE_NAME}:${RESOLVED_IMAGE_TAG} .'
                }
            }
        }

        stage('Amazon ECR Push') {
            when {
                anyOf {
                    expression { params.DEPLOY_TARGET == 'ecr-push' }
                    expression { params.DEPLOY_TARGET == 'eks-deploy' }
                }
            }
            steps {
                dir(env.BACKEND_DIR) {
                    sh 'aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}'
                    sh 'docker tag ${IMAGE_NAME}:${RESOLVED_IMAGE_TAG} ${ECR_IMAGE}'
                    sh 'docker push ${ECR_IMAGE}'
                }
            }
        }

        stage('인프라 소스 체크아웃') {
            when {
                expression { params.DEPLOY_TARGET == 'eks-deploy' }
            }
            steps {
                dir(env.INFRA_DIR) {
                    git branch: params.INFRA_BRANCH, url: params.INFRA_REPOSITORY_URL
                }
            }
        }

        stage('EKS 배포') {
            when {
                expression { params.DEPLOY_TARGET == 'eks-deploy' }
            }
            steps {
                dir(env.INFRA_DIR) {
                    sh 'kubectl apply -k "${K8S_OVERLAY_PATH}"'
                }
                sh 'kubectl set image deployment/"${EKS_DEPLOYMENT_NAME}" "${EKS_CONTAINER_NAME}"="${ECR_IMAGE}" -n "${EKS_NAMESPACE}"'
                sh 'kubectl rollout status deployment/"${EKS_DEPLOYMENT_NAME}" -n "${EKS_NAMESPACE}" --timeout=180s'
            }
        }
    }

    post {
        success {
            echo "백엔드 파이프라인 성공: ${env.RESOLVED_IMAGE_TAG}"
        }
        failure {
            echo '백엔드 파이프라인 실패'
        }
        always {
            archiveArtifacts allowEmptyArchive: true, artifacts: "${env.BACKEND_DIR}/build/libs/*.jar"
        }
    }
}
