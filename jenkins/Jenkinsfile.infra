pipeline {
    agent any
    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    environment {
        TF_IN_AUTOMATION = 'true'
    }
    stages {
        stage('Terraform 형식 검사') {
            steps { sh 'terraform fmt -check -recursive terraform' }
        }
        stage('기반 구성 검증') {
            steps {
                dir('terraform/envs/dev') {
                    // AWS 자격증명/S3 state 없이 provider와 로컬 모듈만 초기화한다.
                    sh 'terraform init -backend=false -input=false -lockfile=readonly'
                    sh 'terraform validate'
                    // mock_provider를 사용하는 테스트만 있다. 실제 AWS plan/apply는 실행하지 않는다.
                    sh 'terraform test'
                }
            }
        }
    }
}
